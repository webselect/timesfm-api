# --- Modele -----------------------------------------------------------------
TIMESFM_CHECKPOINT=google/timesfm-3.0-pytorch
# auto | mps | cuda | cpu   (auto -> mps sur Apple Silicon, sinon cuda, sinon cpu)
TIMESFM_DEVICE=auto
TIMESFM_PER_CORE_BATCH_SIZE=4
# TIMESFM_REVISION=
# TIMESFM_CACHE_DIR=
# TIMESFM_LOCAL_FILES_ONLY=false
# HF_TOKEN=

# --- Options de construction du modele (figees au chargement) ---------------
TIMESFM_USE_STITCHING=true
TIMESFM_USE_LINEAR_DETRENDING=true
TIMESFM_LINEAR_DETRENDING_THRESHOLD=0.5
TIMESFM_USE_ITERATIVE_CPM_REVIN=true
TIMESFM_USE_FROZEN_RUNNING_STATS=false
TIMESFM_USE_VARIATE_ATTENTION=true
TIMESFM_USE_SDPA=true
TIMESFM_VALUE_CLIP=1e20
TIMESFM_INPUT_TRANSFORM=identity

# --- Garde-fous de l'API ----------------------------------------------------
API_MAX_SERIES=32
API_MAX_HORIZON=1024
API_MAX_VARIATES=64
API_PRELOAD=true
API_HOST=127.0.0.1
API_PORT=8000

# --- PyTorch / Metal --------------------------------------------------------
# Certaines operations ne sont pas implementees en Metal : bascule sur CPU
# au lieu de lever une exception.
PYTORCH_ENABLE_MPS_FALLBACK=1
